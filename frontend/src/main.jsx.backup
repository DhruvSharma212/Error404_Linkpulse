import React,{useEffect,useState} from 'react';
import{createRoot}from'react-dom/client';
import{AreaChart,Area,CartesianGrid,XAxis,YAxis,Tooltip,ResponsiveContainer,BarChart,Bar}from'recharts';
import{Link2,ChartNoAxesCombined,ShieldCheck,Plus,RefreshCw,Search,Copy,ExternalLink,QrCode,Trash2,Pause,Play,Download,MousePointerClick,Zap,AlertTriangle,X,Check,Activity,ArrowUpRight,Globe2,Command,Clock3,ArrowRight,Layers3,ChevronDown}from'lucide-react';
import'./index.css';
const API=(import.meta.env.VITE_API_BASE||'').replace(/\/$/,'');
async function call(p,o={}){const r=await fetch(API+p,{headers:{'Content-Type':'application/json',...(o.headers||{})},...o});const d=r.headers.get('content-type')?.includes('json')?await r.json():null;if(!r.ok)throw Error(d?.error||'Request failed');return d}
const dateLabel=s=>s?new Date(s).toLocaleDateString(undefined,{month:'short',day:'numeric'}):'—';
function App(){
 const[tab,T]=useState('Overview'),[links,L]=useState([]),[analytics,A]=useState(null),[signals,G]=useState([]),[error,E]=useState(''),[toast,S]=useState(''),[busy,B]=useState(false),[query,Q]=useState(''),[filter,F]=useState('All'),[modal,M]=useState(false),[made,Made]=useState(null),[form,Form]=useState({original_url:'',title:'',alias:'',campaign:'General',expires_at:'',click_limit:''});
 async function refresh(){B(true);try{const[x,y,z]=await Promise.all([call('/api/links'),call('/api/analytics'),call('/api/guard')]);L(x);A(y);G(z);E('')}catch(e){E(e.message)}finally{B(false)}}
 useEffect(()=>{refresh()},[]);useEffect(()=>{if(!toast)return;const t=setTimeout(()=>S(''),2600);return()=>clearTimeout(t)},[toast]);
 async function create(e){e.preventDefault();try{const x=await call('/api/links',{method:'POST',body:JSON.stringify({...form,click_limit:form.click_limit||null,expires_at:form.expires_at||null})});Made(x);M(false);Form({original_url:'',title:'',alias:'',campaign:'General',expires_at:'',click_limit:''});S('Your short link is ready');await refresh()}catch(e){E(e.message)}}
 async function patch(l){try{await call('/api/links/'+l.id,{method:'PATCH',body:JSON.stringify({is_active:!l.is_active})});S(l.is_active?'Link paused':'Link resumed');refresh()}catch(e){E(e.message)}}
 async function del(l){if(!confirm('Delete this link and its click history?'))return;try{await call('/api/links/'+l.id,{method:'DELETE'});S('Link deleted');refresh()}catch(e){E(e.message)}}
 async function copy(t){try{await navigator.clipboard.writeText(t);S('Copied to clipboard')}catch{S(t)}}
 async function qr(l){try{const r=await fetch(API+'/api/links/'+l.id+'/qr');if(!r.ok)throw Error('QR could not be generated');const b=await r.blob(),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='linkpulse-'+l.code+'.png';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)}catch(e){E(e.message)}}
 const shown=links.filter(l=>(l.code+' '+l.title+' '+l.original_url+' '+l.campaign).toLowerCase().includes(query.toLowerCase())&&(filter==='All'||l.status===filter));
 const stats=[{label:'Tracked visits',value:analytics?.total_clicks??'—',sub:'Real redirect events',icon:MousePointerClick,kind:'blue'},{label:'Links created',value:analytics?.total_links??'—',sub:'Across your workspace',icon:Link2,kind:'orange'},{label:'Live destinations',value:analytics?.active_links??'—',sub:'Ready to redirect',icon:Zap,kind:'green'},{label:'Guard signals',value:analytics?.flagged_links??'—',sub:'Worth a closer look',icon:ShieldCheck,kind:'purple'}];
 const nav=[['Overview',ChartNoAxesCombined],['Links',Link2],['LinkGuard',ShieldCheck]];
 return <div className="app-shell">
  <aside className="sidebar"><a className="brand" href="#top" onClick={e=>{e.preventDefault();T('Overview')}}><span className="brand-mark"><Link2 size={25}/></span><span><b>linkpulse<span>.</span></b><small>LINK INTELLIGENCE</small></span></a><div className="workspace-label">WORKSPACE <span>01</span></div><nav>{nav.map(([n,I],i)=><button key={n} onClick={()=>T(n)} className={'nav-item '+(tab===n?'selected':'')}><I size={18}/><span>{n}</span>{n==='LinkGuard'&&signals.length>0&&<em>{signals.length}</em>}{tab===n&&<span className="nav-dot"/>}</button>)}</nav><div className="sidebar-spacer"/><div className="guard-mini"><div className="guard-mini-top"><span className="guard-icon"><ShieldCheck size={18}/></span><span className="live-tag"><i/> RULE ENGINE</span></div><h3>Good links.<br/>Clear signals.</h3><p>Understand traffic patterns before they become problems.</p><button onClick={()=>T('LinkGuard')}>Explore LinkGuard <ArrowUpRight size={14}/></button></div><div className="sidebar-bottom"><span className="avatar">E4</span><div><b>Team Error 404</b><small>INNOVISTA · 2026</small></div><ChevronDown size={15}/></div></aside>
  <div className="main-column" id="top"><header className="topbar"><div className="crumb"><span>Workspace</span><span className="crumb-slash">/</span><b>{tab}</b></div><div className="top-actions"><span className="status-pill"><i/> API workspace</span><button className="icon-button" title="Refresh data" onClick={refresh}><RefreshCw size={16} className={busy?'spin':''}/></button><button className="button button-dark" onClick={()=>M(true)}><Plus size={16}/> New link</button></div></header>
  <main className="content">{error&&<div className="error-banner"><AlertTriangle size={18}/><span>{error}</span><button onClick={()=>E('')}><X size={16}/></button></div>}
  {tab==='Overview'&&<>
   <section className="hero"><div className="hero-copy"><div className="eyebrow"><span className="eyebrow-line"/> THE LINK PERFORMANCE DESK</div><h1>Make every click<br/> <em>mean something.</em></h1><p>One place to create, measure and protect your links. Less guessing, more signal.</p><div className="hero-buttons"><button className="button button-dark" onClick={()=>M(true)}><Plus size={16}/> Create a short link <ArrowRight size={15}/></button><button className="text-button" onClick={()=>T('LinkGuard')}>Explore LinkGuard <ArrowUpRight size={15}/></button></div></div><div className="hero-art"><div className="orbit orbit-one"/><div className="orbit orbit-two"/><div className="orbit-core"><Link2 size={37}/></div><div className="float-card float-card-a"><span className="float-icon blue"><MousePointerClick size={15}/></span><span><small>LIVE SIGNAL</small><b>Click tracked</b></span><Check size={15} className="float-check"/></div><div className="float-card float-card-b"><span className="mini-bars"><i/><i/><i/><i/><i/></span><span><small>LINK HEALTH</small><b>All systems go</b></span></div><span className="art-spark spark-a">✳</span><span className="art-spark spark-b">✦</span></div><div className="hero-index"><span>01 — 03</span><span>LINKS · ANALYTICS · TRUST</span></div></section>
   <div className="section-heading"><div><span className="section-kicker">AT A GLANCE</span><h2>Your workspace, in numbers</h2></div><span className="updated-label"><Clock3 size={13}/> Live data <span className="updated-dot"/></span></div>
   <section className="stats-grid">{stats.map(({label,value,sub,icon:I,kind},i)=><article className={'stat-card '+kind} key={label}><div className="stat-top"><span>{label}</span><span className="stat-icon"><I size={18}/></span></div><div className="stat-number">{value}</div><div className="stat-foot"><span>{sub}</span><span className="stat-index">0{i+1}</span></div></article>)}</section>
   <section className="analytics-grid"><article className="panel chart-panel"><div className="panel-heading"><div><span className="section-kicker">PERFORMANCE</span><h3>Click activity</h3><p>Daily visits over the last 7 days</p></div><span className="chart-tag"><span/> VISITS</span></div><div className="chart-area">{analytics?.weekly?.length?<ResponsiveContainer width="100%" height="100%"><AreaChart data={analytics.weekly} margin={{top:10,right:8,left:-20,bottom:0}}><defs><linearGradient id="pulseFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor="#3657ed" stopOpacity={.22}/><stop offset="95%" stopColor="#3657ed" stopOpacity={0}/></linearGradient></defs><CartesianGrid stroke="#e8e9ed" strokeDasharray="3 5" vertical={false}/><XAxis dataKey="date" tickFormatter={dateLabel} axisLine={false} tickLine={false} tick={{fill:'#858997',fontSize:11}} dy={9}/><YAxis allowDecimals={false} axisLine={false} tickLine={false} tick={{fill:'#858997',fontSize:11}}/><Tooltip contentStyle={{background:'#fff',border:'1px solid #e6e7ec',borderRadius:12,fontSize:12}}/><Area type="monotone" dataKey="clicks" stroke="#3657ed" strokeWidth={2.5} fill="url(#pulseFill)" activeDot={{r:5,fill:'#3657ed',stroke:'#fff',strokeWidth:2}}/></AreaChart></ResponsiveContainer>:<div className="empty-chart"><span className="empty-chart-icon"><ChartNoAxesCombined size={22}/></span><b>Your activity starts here</b><p>Create a short link and open it to record the first visit.</p><button onClick={()=>M(true)}>Create first link <ArrowRight size={14}/></button></div>}</div></article>
   <article className="panel device-panel"><div className="panel-heading"><div><span className="section-kicker">AUDIENCE</span><h3>Where clicks come from</h3><p>Device mix from recorded visits</p></div><span className="panel-badge"><Globe2 size={16}/></span></div>{analytics?.devices?.length?<><div className="device-total"><b>{analytics.total_clicks}</b><span>total visits</span></div><div className="device-bars">{analytics.devices.map((d,i)=><div className="device-row" key={d.name}><div><span className={'device-dot d'+i}/>{d.name}<b>{d.value}</b></div><div className="bar-track"><span style={{width:`${analytics.total_clicks?Math.max(4,d.value/analytics.total_clicks*100):0}%`}} className={'bar-fill d'+i}/></div></div>)}</div></>:<div className="device-empty"><div className="device-illustration"><Globe2 size={28}/><span/><span/><span/></div><b>No audience data yet</b><p>Device insights appear when people visit your short links.</p></div>}<div className="panel-bottom-note"><Activity size={14}/> Insights update when a short link is visited.</div></article></section>
   <section className="bottom-grid"><article className="panel list-panel"><div className="panel-heading"><div><span className="section-kicker">YOUR TOP PERFORMERS</span><h3>Popular links</h3></div><button className="inline-link" onClick={()=>T('Links')}>All links <ArrowRight size={14}/></button></div>{analytics?.top_links?.length?analytics.top_links.slice(0,4).map((l,i)=><div className="popular-row" key={l.code}><span className="popular-rank">0{i+1}</span><span className="popular-link-icon"><Link2 size={16}/></span><div className="popular-info"><b>{l.title||'Untitled link'}</b><small>/{l.code} · {l.campaign}</small></div><div className="popular-clicks"><b>{l.clicks}</b><small>clicks</small></div><button className="row-arrow" onClick={()=>T('Links')}><ArrowUpRight size={16}/></button></div>):<div className="empty-list">Your most visited links will show up here.</div>}</article><article className="panel activity-panel"><div className="panel-heading"><div><span className="section-kicker">IN REAL TIME</span><h3>Recent activity</h3></div><span className="activity-live"><i/> LIVE</span></div>{analytics?.recent_clicks?.length?analytics.recent_clicks.slice(0,4).map(e=><div className="activity-row" key={e.id}><span className="activity-icon"><MousePointerClick size={16}/></span><div><b>Visit recorded <span>/{e.code}</span></b><small>{e.device} · {e.browser||'Unknown browser'}</small></div><time>{new Date(e.clicked_at).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</time></div>):<div className="empty-list">No visits yet. Your first click will appear here.</div>}<button className="activity-footer" onClick={()=>T('Links')}>Manage your links <ArrowRight size={14}/></button></article></section>
  </>}
  {tab==='Links'&&<><section className="page-intro"><div><div className="eyebrow"><span className="eyebrow-line"/> LINK LIBRARY</div><h1>All your links.<br/><em>One clear view.</em></h1><p>Organize destinations, track activity and control every redirect.</p></div><button className="button button-dark" onClick={()=>M(true)}><Plus size={16}/> Create a link</button></section><section className="panel link-manager"><div className="manager-head"><div><span className="section-kicker">LINK MANAGEMENT</span><h3>Link library <span className="count-badge">{links.length}</span></h3></div><a className="button button-outline" href={API+'/api/export.csv'}><Download size={15}/> Export CSV</a></div><div className="filter-row"><div className="search-box"><Search size={17}/><input value={query} onChange={e=>Q(e.target.value)} placeholder="Search title, URL or campaign..."/></div><select value={filter} onChange={e=>F(e.target.value)}>{['All','Active','Paused','Expired','Limit reached'].map(x=><option key={x}>{x}</option>)}</select></div><div className="table-wrap"><table><thead><tr><th>SHORT LINK</th><th>DESTINATION</th><th>CAMPAIGN</th><th>VISITS</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody>{shown.map(l=><tr key={l.id}><td><div className="table-short"><span><Link2 size={15}/></span><div><b>/{l.code}</b><small>{l.title||'Untitled link'}</small></div></div></td><td><div className="destination-cell" title={l.original_url}>{l.original_url}</div></td><td><span className="campaign-chip">{l.campaign||'General'}</span></td><td><b className="visit-count">{l.clicks}</b></td><td><span className={'status-label '+(l.status==='Active'?'active':'inactive')}><i/>{l.status}</span></td><td><div className="table-actions"><button title="Copy short link" onClick={()=>copy(l.short_url)}><Copy size={15}/></button><button title="Open link" onClick={()=>window.open(API+'/r/'+l.code,'_blank','noopener,noreferrer')}><ExternalLink size={15}/></button><button title="Download QR" onClick={()=>qr(l)}><QrCode size={15}/></button><button title={l.is_active?'Pause link':'Resume link'} onClick={()=>patch(l)}>{l.is_active?<Pause size={15}/>:<Play size={15}/>}</button><button title="Delete link" className="delete-action" onClick={()=>del(l)}><Trash2 size={15}/></button></div></td></tr>)}</tbody></table>{!shown.length&&<div className="empty-table"><Layers3 size={25}/><b>No matching links</b><p>Create a link or adjust your search.</p></div>}</div></section></>}
  {tab==='LinkGuard'&&<><section className="page-intro guard-intro"><div><div className="eyebrow"><span className="eyebrow-line orange-line"/> LINKGUARD · TRAFFIC TRUST</div><h1>See the signal.<br/><em className="orange-text">Not just the click.</em></h1><p>Explainable traffic rules help your team spot unusual patterns and decide what to investigate.</p></div><div className="guard-status-card"><span className="guard-status-icon"><ShieldCheck size={22}/></span><div><b>Rules-based monitoring</b><small><i/> ENGINE AVAILABLE</small></div></div></section><section className="guard-summary"><article><span className="guard-summary-icon orange-bg"><AlertTriangle size={18}/></span><small>OPEN SIGNALS</small><b>{signals.length}</b><p>Events to review</p></article><article><span className="guard-summary-icon blue-bg"><Link2 size={18}/></span><small>LINKS FLAGGED</small><b>{new Set(signals.map(x=>x.link_id)).size}</b><p>Unique destinations</p></article><article><span className="guard-summary-icon green-bg"><ShieldCheck size={18}/></span><small>DETECTION MODE</small><b className="rule-active">Active</b><p>Burst & bot-like patterns</p></article></section><section className="panel signal-panel"><div className="panel-heading"><div><span className="section-kicker">INVESTIGATION QUEUE</span><h3>Signals to review</h3><p>Flags are prompts to investigate, not proof of abuse.</p></div><span className="count-badge">{signals.length} signals</span></div>{signals.length?signals.map(x=><div className="signal-row" key={x.id}><span className={'signal-mark '+String(x.severity).toLowerCase()}><AlertTriangle size={18}/></span><div className="signal-main"><div className="signal-title">{x.title}<span className={'severity-chip '+String(x.severity).toLowerCase()}>{x.severity||'Review'} · {x.kind}</span></div><p>{x.reason}</p><small>Suggested next step: {x.recommendation}</small><code>/{x.code}</code></div>{links.find(l=>l.id===x.link_id)?.is_active&&<button className="button button-outline pause-signal" onClick={()=>patch(links.find(l=>l.id===x.link_id))}><Pause size={14}/> Pause link</button>}</div>):<div className="no-signals"><div className="no-signals-art"><ShieldCheck size={34}/><span>✓</span></div><h3>Nothing unusual in the queue</h3><p>No active LinkGuard signals have been recorded. Signals will appear when traffic patterns match a detection rule.</p><button className="button button-outline" onClick={refresh}><RefreshCw size={14}/> Refresh signals</button></div>}</section></>}
  <footer className="footer"><span>© 2026 LinkPulse <b>·</b> Built by Team Error 404</span><span><span className="footer-dot"/> React + Flask <b>·</b> Link intelligence for everyone</span></footer>
  </main></div>
  {modal&&<div className="modal-backdrop" onMouseDown={e=>{if(e.target===e.currentTarget)M(false)}}><div className="create-modal"><div className="modal-top"><div><span className="section-kicker">NEW DESTINATION</span><h2>Give your link<br/><em>a little purpose.</em></h2></div><button className="modal-close" onClick={()=>M(false)}><X size={19}/></button></div><p className="modal-description">Create a shareable short link and keep an eye on how it performs.</p><form onSubmit={create}><label className="form-label">Destination URL <span>*</span><input required type="url" value={form.original_url} onChange={e=>Form({...form,original_url:e.target.value})} placeholder="https://example.com/your-long-url"/></label><div className="form-two"><label className="form-label">Link title<input value={form.title} onChange={e=>Form({...form,title:e.target.value})} placeholder="e.g. Product launch"/></label><label className="form-label">Campaign<input value={form.campaign} onChange={e=>Form({...form,campaign:e.target.value})} placeholder="General"/></label><label className="form-label">Custom alias<input minLength="3" maxLength="32" pattern="[A-Za-z0-9_-]+" value={form.alias} onChange={e=>Form({...form,alias:e.target.value})} placeholder="my-launch"/></label><label className="form-label">Click limit<input type="number" min="1" value={form.click_limit} onChange={e=>Form({...form,click_limit:e.target.value})} placeholder="No limit"/></label></div><label className="form-label">Expiry date <span className="optional">OPTIONAL</span><input type="datetime-local" value={form.expires_at} onChange={e=>Form({...form,expires_at:e.target.value})}/></label><div className="modal-note"><ShieldCheck size={17}/><span>LinkGuard monitors for unusual activity after visits begin.</span></div><div className="modal-actions"><button type="button" className="button button-outline" onClick={()=>M(false)}>Cancel</button><button className="button button-dark"><Plus size={16}/> Create short link</button></div></form></div></div>}
  {made&&<div className="success-toast"><div className="success-icon"><Check size={17}/></div><div className="success-body"><b>Your short link is ready</b><a href={made.short_url} target="_blank" rel="noreferrer">{made.short_url}</a><div className="success-actions"><button onClick={()=>copy(made.short_url)}><Copy size={14}/> Copy link</button><button onClick={()=>qr(made)}><QrCode size={14}/> Download QR</button></div></div><button className="success-close" onClick={()=>Made(null)}><X size={16}/></button></div>}
  {toast&&<div className="toast"><Check size={16}/>{toast}</div>}
 </div>
}
createRoot(document.getElementById('root')).render(<App/>);
